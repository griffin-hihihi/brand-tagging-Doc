    {
      "id": "scope",
      "title": "短英數配對風險有多少",
      "queries": [
        {
          "id": "local-audit",
          "source": {
            "label": "momo品牌配對存檔與品牌庫",
            "files": [
              {
                "label": "brand_rules.db"
              },
              {
                "label": "brand_pool.csv"
              },
              {
                "label": "short_brand_audit.py"
              }
            ],
            "sql": "SELECT site, level1, item_id, raw_brand, title,\n        \"suggest brand name\" AS matched_name, \"suggest brand id\" AS matched_id,\n        \"信心指數\" AS confidence, 判斷路徑 AS path, tagged_at\n        FROM item_results WHERE site = ?",
            "filters": [
              "站點：momo",
              "來源含中文且英數長度1–3",
              "現有品牌英數相同、中文不同，且無human/curated別名支持"
            ],
            "metricDefinitions": [
              {
                "label": "風險品號",
                "definition": "依商品品號計數，來源為品牌欄或空白時的標題第一個【】；品牌字串正規化後去重。"
              }
            ],
            "caveats": [
              "89組2,987件是證據不足篩查，不是已證實錯誤；包含可能正確的MSI、WD、LG等品牌。",
              "本次不含纯英文短名及四字元以上英文的全面篩查。"
            ],
            "evidenceFlow": [
              {
                "kind": "validation",
                "title": "粒度核對",
                "detail": "共545,572列，545,572個不同品號，涵蓋22類別；品牌庫76,675個ID。"
              }
            ]
          },
          "reportingPeriod": "存檔輸出時間：2026-09-21 14:56:34–15:02:33；不是商品採集時間",
          "columns": [
            "英數長度",
            "風險字串",
            "風險品號"
          ],
          "rows": [
            {
              "英數長度": "2",
              "風險字串": 28,
              "風險品號": 899
            },
            {
              "英數長度": "3",
              "風險字串": 61,
              "風險品號": 2088
            }
          ],
          "preview": {
            "kind": "aggregate",
            "note": "全站風險篩查依英數長度彙總",
            "totalRows": 2987
          }
        }
      ]
    },
