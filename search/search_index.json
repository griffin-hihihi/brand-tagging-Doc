{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u7af6\u7db2\u54c1\u724c\u5c0d\u61c9\u4f5c\u696d\u8aaa\u660e\u66f8\uff1a\u6c7a\u7b56\u9ad4\u7cfb\u3001\u5224\u5b9a\u898f\u5247\u8207\u8f38\u51fa\u6a19\u6e96","text":"<p>\u7248\u672c\uff1av1.5\u3000\uff5c\u3000\u9069\u7528\u7bc4\u570d\uff1amomo \u5168\u7ad9\u5546\u54c1\uff08545,572 \u54c1\u865f\uff09\u3000\uff5c\u3000\u6700\u5f8c\u66f4\u65b0\uff1a2026/09/21</p>"},{"location":"#1","title":"1. \u5c08\u6848\u76ee\u6a19\u8207\u6838\u5fc3\u539f\u5247","text":""},{"location":"#11","title":"1.1 \u696d\u52d9\u75db\u9ede\u8207\u5c08\u6848\u76ee\u6a19","text":"<p>\u96fb\u5546\u7af6\u7db2\uff08momo\uff09\u5546\u54c1\u4e2d\uff0c\u54c1\u724c\u6b04\u4f4d\u586b\u5beb\u683c\u5f0f\u6df7\u4e82\uff0c\u5e38\u898b\u300c\u4e2d\u82f1\u4e26\u5217\u300d\u3001\u300c\u6bcd\u5b50\u54c1\u724c\u91cd\u758a\u300d\u3001\u300c\u578b\u865f\u898f\u683c\u6df7\u5165\u54c1\u724c\u6b04\u300d\u3001\u300c\u7a7a\u767d\u672a\u586b\u300d\u6216\u300c\u526f\u5ee0\u5468\u908a\u914d\u4ef6\u501f\u7528\u539f\u5ee0\u540d\u7a31\u300d\u7b49\u73fe\u8c61\u3002</p> <p>\u672c\u5c08\u6848\u4e4b\u6838\u5fc3\u76ee\u6a19\u5728\u65bc\u5efa\u7acb\u4e00\u5957\u53ef\u91cd\u8907\u57f7\u884ctagging\u65b9\u6cd5\uff0c\u5c07\u7af6\u7db2\u5546\u54c1\u5168\u6578\u6a19\u6e96\u5316\u5c0d\u61c9\u81f3\u65e2\u6709\u4e4b\u6b63\u5f0f\u54c1\u724c\u5eab\uff0c\u7522\u51fa\u4e00\u81f4\u3001\u4e7e\u6de8\u7684\u5546\u54c1\u54c1\u724c\u4e3b\u6a94\u3002</p>"},{"location":"#12","title":"1.2 \u539f\u5247","text":"<p>\u70ba\u78ba\u4fdd\u8de8\u54c1\u985e\u3001\u8de8\u6279\u6b21\u4e4b\u8cc7\u6599\u6a19\u6e96\u5b8c\u5168\u4e00\u81f4\uff0c\u7cfb\u7d71\u5168\u6d41\u7a0b\u56b4\u683c\u8cab\u5fb9\u4ee5\u4e0b\u4e09\u539f\u5247\uff1a</p> <ol> <li>\u6700\u5177\u9ad4\u5b50\u54c1\u724c\u512a\u5148</li> <li>\u4e0d\u8ad6 3C \u79d1\u6280\u3001\u7f8e\u599d\u6216\u5c45\u5bb6\u751f\u6d3b\uff0c\u5168\u54c1\u985e\u6a19\u6e96\u4fdd\u6301\u4e00\u81f4\uff1a\u7576\u6bcd\u54c1\u724c\u8207\u5b50\u54c1\u724c\u540c\u6642\u5b58\u5728\u65bc\u54c1\u724c\u5eab\u6642\uff0c\u512a\u5148\u6b78\u5165\u6700\u5177\u9ad4\u7684\u5b50\u54c1\u724c\u3002<ul> <li>\u4f8b\uff1a<code>Apple iPhone 15</code> \u2794 \u540c\u6642\u5305\u542b Apple \u8207 iPhone \u2794 \u6b78\u5165 <code>iphone</code>\u3002</li> <li>\u4f8b\uff1a<code>ASUS ROG \u96fb\u7af6\u4e3b\u6a5f\u677f</code> \u2794 \u540c\u6642\u5305\u542b ASUS \u8207 ROG \u2794 \u6b78\u5165 <code>ROG</code>\u3002</li> <li>\u4f8b\uff1a<code>Kanebo KATE \u51f1\u5a77 \u7709\u7b46</code> \u2794 \u540c\u6642\u5305\u542b Kanebo \u8207 KATE \u2794 \u6b78\u5165 <code>KATE \u51f1\u5a77</code>\u3002</li> </ul> </li> <li> <p>\u82e5\u5b50\u54c1\u724c\u5c1a\u672a\u6536\u9304\u65bc\u54c1\u724c\u5eab\uff0c\u5247\u4f9d\u73fe\u6709\u8cc7\u6599\u908a\u754c\u6b78\u5165\u6bcd\u54c1\u724c\uff08\u4f8b\uff1a<code>Apple iPad Air</code> \u2794 \u5eab\u5167\u7121 iPad \u54c1\u724c \u2794 \u6b78\u5165 <code>Apple</code>\uff09\uff0c\u4e0d\u81ea\u884c\u6191\u7a7a\u5efa\u7acb\u672a\u7d93\u6838\u51c6\u4e4b\u4ee3\u78bc\u3002</p> </li> <li> <p>\u54c1\u985e\u908a\u754c\u9694\u96e2\uff08\u675c\u7d55\u8de8\u985e\u8aa4\u5224\uff09</p> </li> <li>\u6bd4\u5c0d\u6642\u512a\u5148\u6821\u9a57\u5546\u54c1\u6240\u5c6c\u4e4b\u4e00\u7d1a\u54c1\u985e\u3002</li> <li> <p>\u82e5\u5546\u54c1\u6587\u5b57\u50c5\u5c40\u90e8\u5305\u542b\u67d0\u500b\u54c1\u724c\u540d\u7a31\uff0c\u4f46\u5169\u8005\u54c1\u985e\u5b8c\u5168\u4e0d\u7b26\uff0c\u7cfb\u7d71\u5224\u5b9a\u70ba\u4e0d\u76f8\u7b26\u3002\u4f8b\u5982\u66f8\u7c4d\u985e\u6f2b\u756b\u300aKING GOLF\u300b\u5167\u542b\u55ae\u5b57 <code>GOLF</code>\uff0c\u800c\u54c1\u724c\u5eab\u4e2d\u7684 <code>GOLF</code> \u767b\u8a18\u70ba\u6c7d\u8eca\u914d\u4ef6\uff0c\u7cfb\u7d71\u76f4\u63a5\u5426\u6c7a\uff0c\u9632\u6b62\u8de8\u9818\u57df\u8aa4\u5c0d\u61c9\u3002</p> </li> <li> <p>\u76f8\u5bb9\u5468\u908a\u8207\u526f\u5ee0\u4e4b\u88fd\u9020\u5546\u7cbe\u6e96\u8b58\u5225</p> </li> <li>\u7121\u7368\u7acb\u54c1\u724c\u4e4b\u7d14\u76f8\u5bb9\u914d\u4ef6\uff1a\u624b\u6a5f\u4fdd\u8b77\u8cbc\u3001\u901a\u7528\u8f49\u63a5\u7dda\u3001\u767d\u724c\u526f\u5ee0\u652f\u67b6\u7b49\uff0c\u672c\u9ad4\u4e26\u975e\u539f\u5ee0\u6240\u88fd\u3002\u7cfb\u7d71\u4e00\u5f8b\u5c07\u7d14\u76f8\u5bb9\u63cf\u8ff0\uff08\u5982\u300c\u9069\u7528 iPhone\u300d\u3001\u300cSwitch \u526f\u5ee0\u300d\uff09\u6536\u6582\u70ba\u7121\u54c1\u724c\uff08No brand\uff09\uff0c\u907f\u514d\u6c61\u67d3\u539f\u5ee0\u54c1\u724c\u5eab\u92b7\u552e\u7d71\u8a08\u3002</li> <li>\u5177\u7368\u7acb\u7b2c\u4e09\u65b9\u88fd\u9020\u5546\u54c1\u724c\u4e4b\u5468\u908a\uff1a\u4f8b\u5982 <code>\u3010ipega\u3011\u526f\u5ee0 Switch \u904b\u52d5\u6307\u5957</code>\u3001<code>\u3010\u7280\u725b\u76fe\u3011iPhone 15 \u9632\u6454\u4fdd\u8b77\u6bbc</code>\u3001<code>\u3010\u826f\u503c\u3011Switch \u526f\u5ee0\u624b\u628a\u5c08\u7528\u8155\u5e36</code>\u3002\u7cfb\u7d71\u7cbe\u6e96\u8b58\u5225\u5176\u7b2c\u4e09\u65b9\u88fd\u9020\u5546\u8eab\u4efd\uff0c\u6b63\u78ba\u6b78\u5165\u8a72\u54c1\u724c\u5eab\uff08Ipega\u3001\u7280\u725b\u76fe\uff09\u6216\u5efa\u8b70\u65b0\u589e\uff08\u826f\u503c\uff09\uff0c\u7d55\u4e0d\u56e0\u5167\u6587\u5305\u542b\u300c\u526f\u5ee0\u300d\u6216\u76f8\u5bb9\u4e3b\u6a5f\u540d\u7a31\u800c\u8aa4\u5224\u70ba\u7121\u54c1\u724c\u3002</li> </ol>"},{"location":"#2","title":"2. \u7e3d\u9ad4\u6c7a\u7b56\u9ad4\u7cfb\u8207\u5224\u5b9a\u6d41\u7a0b","text":""},{"location":"#21","title":"2.1 \u5168\u5c40\u6c7a\u7b56\u6d41\u7a0b\u67b6\u69cb","text":"<p>\u7cfb\u7d71\u5224\u5b9a\u4efb\u4f55\u4e00\u7b46\u5546\u54c1\u6642\uff0c\u4f9d\u5faa\u7531\u9ad8\u78ba\u5b9a\u6027\u5230\u6a21\u7cca\u7279\u5fb5\u7684\u5c64\u6b21\u9032\u884c\u56b4\u683c\u6aa2\u9a57\uff1a</p> <pre><code>flowchart TD\n    Start[\"\u5546\u54c1\u8cc7\u6599\u8f38\u5165&lt;br&gt;(\u54c1\u865f\u3001\u7af6\u7db2\u54c1\u724c\u6b04\u3001\u5546\u54c1\u540d\u7a31\u3001\u54c1\u985e)\"] --&gt; Step1{\"\u3010\u968e\u6bb5\u4e00\u3011\u6b77\u53f2\u78ba\u5b9a\u6027\u6aa2\u9a57&lt;br&gt;\u5148\u524d\u662f\u5426\u66fe\u7d93\u4eba\u5de5\u78ba\u8a8d\u904e\uff1f\"}\n\n    Step1 -- \"\u6709\u6b77\u53f2\u5be9\u6838\u8a18\u9304\" --&gt; End1[\"\u76f4\u63a5\u5957\u7528\u5be9\u6838\u5224\u5b9a\u7d50\u679c&lt;br&gt;(\u8def\u5f91 3.1 / 3.2\uff0c\u4fe1\u5fc3\u5ea6 100 \u5206)\"]\n    Step1 -- \"\u7121\u6b77\u53f2\u8a18\u9304\" --&gt; Step2{\"\u3010\u968e\u6bb5\u4e8c\u3011\u96d9\u8ecc\u6bd4\u5c0d\u908f\u8f2f&lt;br&gt;\u7af6\u7db2\u54c1\u724c\u6b04\u662f\u5426\u6709\u503c\uff1f\"}\n\n    Step2 -- \"\u54c1\u724c\u6b04\u6709\u503c\" --&gt; TrackA[\"\u3010\u8ecc\u9053 A\uff1a\u54c1\u724c\u6b04\u6bd4\u5c0d\u3011&lt;br&gt;1.1 \u76f8\u5bb9/\u7121\u54c1\u724c\u6587\u5b57\u6392\u9664&lt;br&gt;1.3 \u54c1\u724c\u5eab\u5b8c\u5168\u76f8\u7b26(\u542b\u5b50\u54c1\u724c\u512a\u5148)&lt;br&gt;1.4 \u5eab\u5167\u91cd\u8907\u53d6\u696d\u7e3e\u6700\u9ad8&lt;br&gt;1.5 \u591a\u54c1\u724c\u6b67\u7fa9\u9001\u5be9&lt;br&gt;1.6 \u5177\u54c1\u724c\u7279\u5fb5\u4f46\u5eab\u5167\u7121&lt;br&gt;1.7 \u898f\u683c\u8a5e/\u63cf\u8ff0\u8a5e\u6536\u6582\"]\n\n    Step2 -- \"\u54c1\u724c\u6b04\u7a7a\u767d\" --&gt; TrackB[\"\u3010\u8ecc\u9053 B\uff1a\u5546\u54c1\u540d\u7a31\u964d\u7d1a\u6bd4\u5c0d\u3011&lt;br&gt;2.1 \u76f8\u5bb9/\u526f\u5ee0\u914d\u4ef6\u6392\u9664&lt;br&gt;2.2 \u540d\u7a31\u958b\u982d\u3010\u3011\u547d\u4e2d\u54c1\u724c\u5eab&lt;br&gt;2.3 \u540d\u7a31\u958b\u982d\u3010\u3011\u70ba\u65b0\u54c1\u724c&lt;br&gt;2.4 \u6a19\u984c\u5167\u6587\u4e2d\u6bb5\u95dc\u9375\u8a5e\u547d\u4e2d&lt;br&gt;2.5 \u6a19\u984c\u7d14\u63cf\u8ff0\u8a5e\u6536\u6582\"]\n\n    TrackA --&gt; Step3{\"\u3010\u968e\u6bb5\u4e09\u3011\u4e09\u614b\u6536\u6582\u8207\u8f38\u51fa\"}\n    TrackB --&gt; Step3\n\n    Step3 --&gt; Out1[\"\u6b63\u5f0f\u54c1\u724c\u5eab\u54c1\u724c (TYPE_POOL)\"]\n    Step3 --&gt; Out2[\"\u5efa\u8b70\u65b0\u589e\u54c1\u724c (TYPE_NEW)\"]\n    Step3 --&gt; Out3[\"\u7121\u54c1\u724c / No brand (TYPE_NB)\"]</code></pre>"},{"location":"#22","title":"2.2 \u5177\u9ad4\u6c7a\u7b56\u8def\u5f91\u5c0d\u7167\u8868","text":"<p>\u9ede\u64ca\u4e0b\u65b9\u5340\u584a\u53ef\u5c55\u958b\u6aa2\u8996\u5404\u8ecc\u9053\u4e4b\u8a73\u7d30\u5224\u5b9a\u689d\u4ef6\u3001\u4ee3\u78bc\u8207\u5be6\u4f8b\u8aaa\u660e\uff1a</p> \u8ecc\u9053 A\uff1a\u54c1\u724c\u6b04\u6709\u586b\u4e4b\u6c7a\u7b56\u8def\u5f91 (1.1 \uff5e 1.7) \u8def\u5f91\u4ee3\u78bc \u5224\u5b9a\u60c5\u6cc1 \u8f38\u51fa\u985e\u578b \u9810\u8a2d\u4fe1\u5fc3\u5ea6 \u5178\u578b\u7bc4\u4f8b\u8aaa\u660e 1.1 \u54c1\u724c\u6b04\u6587\u5b57\u660e\u78ba\u6a19\u793a\u7121\u54c1\u724c TYPE_NB 97 \u54c1\u724c\u6b04\u586b\u5beb\u300c\u7121\u54c1\u724c\u300d\u3001\u300c\u5176\u4ed6\u300d\u3001\u300c\u81ea\u6709\u54c1\u724c\u300d\u3001\u300cOEM\u300d 1.2 \u54c1\u724c\u6b04\u6587\u5b57\u70ba\u76f8\u5bb9\u6027\u63cf\u8ff0 TYPE_NB 90 \u54c1\u724c\u6b04\u586b\u5beb\u300c\u9069\u7528 iPhone \u5145\u96fb\u7dda\u300d\u3001\u300c\u76f8\u5bb9 Switch \u624b\u628a\u300d 1.3 \u54c1\u724c\u5eab\u5b8c\u5168\u76f8\u7b26\uff08\u542b\u5b50\u54c1\u724c\u512a\u5148\uff09 TYPE_POOL 96 \u300cBURBERRY\u300d\u5b8c\u5168\u76f8\u7b26\uff1b\u300cApple iPhone\u300d\u53d6\u5b50\u54c1\u724c <code>iphone</code> 1.4 \u54c1\u724c\u5eab\u6709\u591a\u7b46\u91cd\u8907\u5efa\u6a94\uff0c\u53d6\u696d\u7e3e\u6700\u9ad8 TYPE_POOL 90 \u54c1\u724c\u5eab\u540c\u6642\u6709 <code>Nintendo</code> \u8207\u91cd\u8907\u4ee3\u78bc\uff0c\u53d6\u6b77\u53f2\u92b7\u552e\u6700\u9ad8\u4e4b\u4e3b\u8981 ID 1.5 \u591a\u500b\u4e0d\u540c\u54c1\u724c\u540c\u6642\u76f8\u7b26\uff0c\u5b58\u5728\u6b67\u7fa9 TYPE_POOL 39 \u54c1\u724c\u6b04\u586b\u300c\u65e5\u672c\u300d\uff0c\u540c\u6642\u547d\u4e2d\u591a\u500b\u5305\u542b\u65e5\u672c\u7684\u54c1\u724c\uff0c\u5217\u5165\u5f85\u5be9 1.6 \u5177\u660e\u78ba\u5546\u6a19\u7279\u5fb5\uff0c\u4f46\u73fe\u6709\u54c1\u724c\u5eab\u672a\u6536\u9304 TYPE_NEW 82 \u300c\u826f\u503c\u300d\u3001\u300cRedMoon\u300d\uff0c\u5b57\u9762\u5177\u5546\u6a19\u7279\u5fb5\u4f46\u5eab\u5167\u67e5\u7121\uff0c\u5efa\u8b70\u65b0\u589e 1.7 \u54c1\u724c\u6b04\u5167\u5bb9\u5be6\u70ba\u898f\u683c\u6216\u4fc3\u92b7\u63cf\u8ff0\u8a5e TYPE_NB 80 \u54c1\u724c\u6b04\u586b\u5beb\u300c\u7279\u50f9\u51fa\u6e05\u300d\u3001\u300c\u6536\u7d0d\u7528\u54c1\u300d\u3001\u300c\u8cb7\u4e00\u9001\u4e00\u300d \u8ecc\u9053 B\uff1a\u54c1\u724c\u6b04\u7a7a\u767d\u4e4b\u964d\u7d1a\u6bd4\u5c0d\u8def\u5f91 (2.1 \uff5e 2.5) \u8def\u5f91\u4ee3\u78bc \u5224\u5b9a\u60c5\u6cc1 \u8f38\u51fa\u985e\u578b \u9810\u8a2d\u4fe1\u5fc3\u5ea6 \u5178\u578b\u7bc4\u4f8b\u8aaa\u660e 2.1 \u5546\u54c1\u70ba\u914d\u4ef6\u3001\u8017\u6750\u6216\u76f8\u5bb9\u5468\u908a TYPE_NB 88 \u6a19\u984c\u300ciPhone 15 \u92fc\u5316\u819c\u300d\u3001\u300cMacBook \u78c1\u5438\u9632\u7aba\u7247\u300d\uff0c\u672c\u9ad4\u975e\u539f\u5ee0 2.2 \u5546\u54c1\u540d\u7a31\u958b\u982d\u3010\u3011\u547d\u4e2d\u73fe\u6709\u54c1\u724c\u5eab TYPE_POOL 86 \u5546\u54c1\u540d\u7a31\u70ba\u300c\u3010AMANO\u3011\u539f\u5ee0\u6253\u5361\u7d19\u300d\uff0c\u6210\u529f\u63d0\u53d6 <code>AMANO</code> 2.3 \u5546\u54c1\u540d\u7a31\u958b\u982d\u3010\u3011\u5177\u54c1\u724c\u7279\u5fb5\u4f46\u5eab\u5167\u7121 TYPE_NEW 72 \u5546\u54c1\u540d\u7a31\u70ba\u300c\u3010MEIDIAN\u3011\u56fa\u9ad4\u9762\u819c\u300d\uff0c\u63d0\u53d6\u65b0\u54c1\u724c\u540d\u7a31 2.4 \u7531\u5546\u54c1\u6a19\u984c\u5167\u6587\u4e2d\u6bb5\u6bd4\u5c0d\u5230\u54c1\u724c TYPE_POOL 52 \u6a19\u984c\u5167\u6587\u4e2d\u6bb5\u51fa\u73fe\u7279\u5b9a\u9577\u54c1\u724c\u540d\uff08\u975e\u914d\u4ef6\u60c5\u5883\uff09 2.5 \u6a19\u984c\u8207\u5167\u6587\u7686\u7121\u53ef\u4fe1\u54c1\u724c\u8cc7\u8a0a TYPE_NB 85 \u6a19\u984c\u70ba\u7d14\u63cf\u8ff0\u6027\u6587\u5b57\uff08\u5982\u300c\u52a0\u539a\u7d14\u68c9\u5438\u6c34\u6bdb\u5dfe 3 \u5165\u88dd\u300d\uff09 \u6b77\u53f2\u8a18\u61b6\u5bb9\u5668\u8207\u4eba\u5de5\u8986\u84cb\u6a5f\u5236 (3.1 \uff5e 3.2) <p>\u9019\u5169\u689d\u8def\u5f91\u662f\u7cfb\u7d71\u7684\u300c\u81ea\u52d5\u8a18\u61b6\u5bb9\u5668\u300d\uff0c\u4e0d\u9700\u8981\u4eba\u54e1\u4e8b\u524d\u624b\u52d5\u9010\u7b46\u8a2d\u5b9a\uff1a</p> <ul> <li>3.1 \u5957\u7528\u6b77\u53f2\u5be9\u6838\u54c1\u724c\u5b57\u4e32\uff08\u5168\u7ad9\u5171\u7528\uff09\uff1a   \u7576\u67d0\u500b\u54c1\u724c\u5b57\u4e32\u5148\u524d\u5df2\u7531\u4eba\u5de5\u6216 Temp \u5728\u5be9\u6838\u7e3d\u8868\u4e2d\u78ba\u8a8d\u904e\uff08\u4f8b\u5982\u78ba\u8a8d\u300c\u7da0\u9418\u300d\u5c0d\u61c9\u70ba <code>GREEN BELL</code>\uff09\uff0c\u8a72\u6c7a\u7b56\u6c38\u4e45\u5b58\u5165\u8cc7\u6599\u5eab\u3002\u65e5\u5f8c\u5168\u7ad9 22 \u500b\u54c1\u985e\u53ea\u8981\u518d\u6b21\u51fa\u73fe\u8a72\u5b57\u4e32\uff0c\u7cfb\u7d71\u76f4\u63a5\u5957\u7528\uff08\u4fe1\u5fc3\u5ea6 100 \u5206\uff09\uff0c\u7d55\u4e0d\u88ab\u6f14\u7b97\u6cd5\u63a8\u7ffb\u3002</li> <li>3.2 \u5957\u7528\u55ae\u4e00\u54c1\u865f\u4f8b\u5916\u8986\u84cb\uff08\u55ae\u54c1\u5c08\u5c6c\uff09\uff1a   \u50c5\u7528\u65bc\u6975\u5c11\u6578\u300c\u5b57\u4e32\u672c\u8eab\u4e0d\u5b9c\u5168\u57df\u66f4\u52d5\uff0c\u4f46\u8a72\u55ae\u4e00\u7279\u4f8b\u54c1\u865f\u9700\u500b\u5225\u6307\u5b9a\u300d\u4e4b\u60c5\u5883\uff08\u4fe1\u5fc3\u5ea6 100 \u5206\uff09\u3002</li> </ul>"},{"location":"#3","title":"3. \u7cfb\u7d71\u8f38\u51fa\u898f\u683c\u8207\u771f\u5be6\u8cc7\u6599\u7bc4\u4f8b","text":""},{"location":"#31","title":"3.1 \u4e09\u5927\u6a19\u6e96\u8f38\u51fa\u985e\u578b\u5b9a\u7fa9","text":"<p>\u7cfb\u7d71\u7522\u51fa\u7684\u6bcf\u7b46\u5546\u54c1\u6700\u7d42\u6536\u6582\u70ba\u4ee5\u4e0b\u4e09\u614b\u4e4b\u4e00\uff0c\u5404\u81ea\u5c0d\u61c9\u660e\u78ba\u7684\u5f8c\u7e8c\u8655\u7406\u6a5f\u5236\uff1a</p> \u8f38\u51fa\u985e\u578b \u5b9a\u7fa9\u8aaa\u660e \u7cfb\u7d71\u6a19\u8a18 \u5f8c\u7e8c\u8655\u7f6e \u54c1\u724c\u5eab\u6b63\u5f0f\u54c1\u724c \u5546\u54c1\u6210\u529f\u5c0d\u61c9\u81f3\u73fe\u6709\u6b63\u5f0f\u54c1\u724c\u5eab TYPE_POOL \u6307\u6d3e\u6b63\u5f0f <code>suggest brand id</code>\uff0c\u76f4\u63a5\u5c0d\u9f4a\u4e3b\u6578\u64da\u4f9b\u696d\u52d9\u8207\u5831\u8868\u4f7f\u7528\u3002 \u5efa\u8b70\u65b0\u589e\u54c1\u724c \u5546\u54c1\u5177\u660e\u78ba\u54c1\u724c\u5546\u6a19\uff0c\u4f46\u73fe\u6709\u54c1\u724c\u5eab\u5c1a\u672a\u6536\u9304 TYPE_NEW \u7522\u51fa\u5efa\u8b70\u540d\u55ae\uff0c\u4f9b\u54c1\u724c\u5eab\u7ba1\u7406\u8005\u8a55\u4f30\u5efa\u6a94\uff0c\u7dad\u8b77\u54c1\u724c\u5eab\u5b8c\u6574\u6027\u3002 \u7121\u54c1\u724c (No brand) \u767d\u724c\u3001\u901a\u7528\u898f\u683c\u54c1\u3001\u6216\u975e\u539f\u5ee0\u4e4b\u76f8\u5bb9\u5468\u908a\u914d\u4ef6 TYPE_NB \u8a18\u9304\u5224\u5b9a\u539f\u56e0\uff08\u5982\u76f8\u5bb9\u914d\u4ef6\u3001\u901a\u7528\u898f\u683c\u7b49\uff09\uff0c\u4e0d\u6307\u6d3e\u4ee3\u78bc\u3002"},{"location":"#32-schema","title":"3.2 \u8f38\u51fa\u5831\u8868\u7db1\u8981\u8207\u6b04\u4f4d\u5b9a\u7fa9 (Schema)","text":"<p>\u6bcf\u6279\u6b21\u57f7\u884c\u5b8c\u6210\u5f8c\u7522\u51fa\u4e4b\u54c1\u985e\u7d50\u679c\u6a94\uff08<code>output/momo/&lt;\u54c1\u985e&gt;_result.xlsx</code>\uff09\u5305\u542b\u4ee5\u4e0b\u6838\u5fc3\u6b04\u4f4d\uff1a</p> \u6b04\u4f4d\u540d\u7a31 \u8cc7\u6599\u578b\u614b \u7bc4\u4f8b\u5167\u5bb9 \u8aaa\u660e \u54c1\u865f \u6578\u5b57/\u6587\u5b57 <code>10000402</code> \u7af6\u7db2\u5546\u54c1\u552f\u4e00\u8b58\u5225\u4ee3\u78bc l1 \u6587\u5b57 <code>Beauty</code> \u5546\u54c1\u6240\u5c6c\u4e4b\u4e00\u7d1a\u54c1\u985e brand \u6587\u5b57 <code>BURBERRY \u5df4\u5bf6\u8389</code> \u7af6\u7db2\u5546\u54c1\u539f\u59cb\u54c1\u724c\u6b04\u4f4d\u5167\u5bb9\uff08\u82e5\u7a7a\u767d\u5247\u70ba nan\uff09 title \u6587\u5b57 <code>\u3010BURBERRY \u5df4\u5bf6\u8389\u3011\u98a8\u683c\u7537\u6027\u6de1\u9999\u6c34</code> \u7af6\u7db2\u5546\u54c1\u539f\u59cb\u6a19\u984c suggest brand name \u6587\u5b57 <code>Burberry</code> \u7cfb\u7d71\u6700\u7d42\u5efa\u8b70\u5c0d\u61c9\u4e4b\u54c1\u724c\u540d\u7a31\uff08\u6216\u6a19\u793a\u5efa\u8b70\u65b0\u589e / No brand\uff09 suggest brand id \u6578\u5b57 <code>1146353</code> \u6b63\u5f0f\u54c1\u724c\u5eab\u54c1\u724c ID\uff08\u82e5\u70ba\u65b0\u54c1\u724c\u6216\u7121\u54c1\u724c\u5247\u70ba\u7a